DB_URL=jdbc:mysql://your-db-host:3306/hireconnect_auth?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=false&serverTimezone=UTC
DB_USERNAME=your_db_user
DB_PASSWORD=replace_with_strong_password
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
JWT_SECRET=replace_with_a_long_random_secret
OAUTH2_DEFAULT_SUCCESS_URL=https://your-frontend-domain.com/oauth2/callback
SERVER_PORT=8081
