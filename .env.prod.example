# Copy this file to .env.prod on the AWS EC2 server and fill real values there.
# Do not commit .env.prod.

APP_PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP

MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
DB_HOST=mysql
DB_USERNAME=root
DB_PASSWORD=replace-with-a-strong-password

JWT_SECRET=replace-with-a-long-base64-secret
SECURITY_ENABLED=true

CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HEALTH_ENABLED=false

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hireconnect
RABBITMQ_PASSWORD=replace-with-a-strong-password
MESSAGING_ENABLED=true

MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=replace-with-a-new-gmail-app-password
MAIL_FROM=your-sender@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10

RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_MOCK_MODE=false

GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
OAUTH2_DEFAULT_SUCCESS_URL=http://YOUR_EC2_PUBLIC_IP/oauth2/callback

FRONTEND_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP
PUBLIC_BASE_URL=http://YOUR_EC2_PUBLIC_IP

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@hireconnect.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
